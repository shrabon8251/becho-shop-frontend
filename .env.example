# Real backend base URL. Leave empty to use the local demo (mock) backend.
VITE_API_URL=
# Storefront store id for the real backend (numeric). Used when VITE_API_URL is set.
# Can also be overridden per-visit with ?store=<id>.
VITE_STOREFRONT_STORE_ID=
# Google OAuth client ID for real Google sign-in (Google Identity Services).
# Get one at https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=
